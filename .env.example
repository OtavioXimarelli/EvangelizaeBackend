# Production runtime for Coolify or docker run.
# Generate LITURGY_IMPORT_TOKEN with: openssl rand -hex 32
SPRING_PROFILES_ACTIVE=prod
PORT=8080
APP_CORS_ALLOWED_ORIGINS=https://evangelizae.com
MONGODB_URI=mongodb://username:password@mongo-host:27017/evangelizae?authSource=admin
LITURGY_IMPORT_TOKEN=replace-with-at-least-32-random-bytes

# LiturgyScraper worker setting, configured in the worker deployment:
# LITURGY_IMPORT_URL=https://api.evangelizae.com/internal/v1/liturgy/import
