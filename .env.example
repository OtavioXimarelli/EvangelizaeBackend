# Copy to .env on the VPS and replace every placeholder. Never commit .env.
#   cp .env.example .env && chmod 600 .env
#   openssl rand -hex 32   # generate secrets

# --- Site -------------------------------------------------------------------
# A record for this domain must point at the VPS before first start, or the
# automatic TLS certificate will fail to issue.
SITE_DOMAIN=evangelizae.com
ACME_EMAIL=you@example.com

# --- MongoDB ----------------------------------------------------------------
# The compose stack builds MONGODB_URI from these; you do not set it by hand.
# MONGO_ROOT_* is used once, only to initialise the data volume.
# MONGO_APP_* is the least-privileged user the API actually connects as.
MONGO_DATABASE=evangelizae
MONGO_ROOT_USERNAME=evangelizae_root
MONGO_ROOT_PASSWORD=replace-with-openssl-rand-hex-32
MONGO_APP_USERNAME=evangelizae
MONGO_APP_PASSWORD=replace-with-openssl-rand-hex-32

# --- API --------------------------------------------------------------------
# Comma-separated exact origins. No wildcards.
APP_CORS_ALLOWED_ORIGINS=https://evangelizae.com
# Shared with the scraper deployment. Minimum 32 characters; the API refuses to
# start otherwise.
LITURGY_IMPORT_TOKEN=replace-with-openssl-rand-hex-32
# Optional JVM tuning, applied without rebuilding the image.
API_JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError

# --- Scraper ----------------------------------------------------------------
SCRAPER_DAYS_BEHIND=7
SCRAPER_DAYS_AHEAD=14
HTTP_TIMEOUT_SECONDS=30
SCRAPER_LOG_LEVEL=INFO
