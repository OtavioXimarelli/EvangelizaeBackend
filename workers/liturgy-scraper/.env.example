# Spring Boot import endpoint (batch receiver)
LITURGY_IMPORT_URL=http://localhost:8080/internal/v1/liturgy/import
# Must be at least 32 characters. The API refuses to start with a short value.
LITURGY_IMPORT_TOKEN=replace-with-openssl-rand-hex-32

# Scraper window. The lookbehind is what makes ingestion self-healing: a
# forward-only window leaves a date that a failed run missed permanently
# unimported, and the API answers 503 for it forever.
# With the defaults a run covers today-7 … today+13, 21 days.
SCRAPER_DAYS_BEHIND=7
SCRAPER_DAYS_AHEAD=14

# IANA zone the liturgical day is defined in. The container runs UTC, where
# `date.today()` is already tomorrow between 21:00 and 24:00 in São Paulo.
SCRAPER_TIMEZONE=America/Sao_Paulo

# HTTP client behavior
HTTP_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
